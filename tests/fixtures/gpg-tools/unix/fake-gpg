#!/bin/sh
# Static subprocess fixture for tests/gpg_tools.rs and tests/common/mod.rs.
#
# IMPORTANT: do not generate, rewrite, or copy this executable from a parallel
# Rust test. A forked child can transiently inherit another thread's writable
# descriptor, causing Linux exec to return ETXTBSY. Mutable state belongs under
# KEYHOLD_TEST_ROOT; this checked-in executable remains immutable.
#
# These fingerprints intentionally correspond to the fixed constants in
# tests/gpg_tools.rs.

: "${KEYHOLD_TEST_ROOT:?KEYHOLD_TEST_ROOT is required}"
root=$KEYHOLD_TEST_ROOT

list=0
loopback=0
background=0
for a in "$@"; do
  [ "$a" = --list-secret-keys ] && list=1
  [ "$a" = --passphrase-fd ] && loopback=1
  [ "$a" = cancel ] && background=1
done
echo "$*" >> "$root/gpg.log"

if [ "$list" = 1 ]; then
  if [ -e "$root/large-stdout" ]; then
    dd if=/dev/zero bs=1024 count=512 2>/dev/null | tr '\000' x
    printf '\n'
  fi
  if [ -e "$root/large-stderr" ]; then
    dd if=/dev/zero bs=1024 count=512 2>/dev/null | tr '\000' e >&2
    printf '\n' >&2
  fi
  cat "$root/keys.txt"
  exit 0
fi

if [ "$background" = 1 ] && [ -e "$root/slow-bg" ]; then
  sleep 2
  echo bg-done >> "$root/gpg.log"
fi

if [ "$background" = 1 ] && [ -e "$root/fail-bg" ]; then
  if [ -e "$root/daemon-tools" ]; then
    echo '[GNUPG:] KEY_CONSIDERED C1D6F8E1B1E8D5FBFF34ACE08FACE96FA6D9DB48 0'
    echo '[GNUPG:] FAILURE sign 67108963'
  fi
  echo 'gpg: signing failed: Operation cancelled' >&2
  exit 2
fi

if [ -e "$root/fail-all" ]; then
  exit 2
fi

locked=$root/lock
if [ -e "$root/daemon-tools" ]; then
  locked=$root/locked
fi
if [ "$background" = 1 ] && [ -e "$locked" ]; then
  echo '[GNUPG:] KEY_CONSIDERED C1D6F8E1B1E8D5FBFF34ACE08FACE96FA6D9DB48 0'
  code=67108963
  [ -e "$root/syserr" ] && code=32867
  echo "[GNUPG:] FAILURE sign $code"
  if [ -e "$root/non-english" ]; then
    echo 'gpg: signature echouee: operation annulee' >&2
  else
    echo 'gpg: signing failed: Operation cancelled' >&2
  fi
  exit 2
fi

if [ "$loopback" = 1 ] && [ -e "$root/daemon-tools" ] && [ -e "$root/slow" ]; then
  sleep 2
fi
if [ "$loopback" = 1 ] && [ -e "$root/hang-loopback" ]; then
  i=0
  while [ "$i" -lt 3000 ]; do
    echo b >> "$root/beats"
    sleep 0.1
    i=$((i + 1))
  done
  exit 0
fi

if [ "$loopback" = 1 ]; then
  IFS= read -r supplied
  expected=$(cat "$root/passphrase")
  if [ "$supplied" != "$expected" ]; then
    code=67108875
    [ -e "$root/syserr" ] && code=32779
    echo "[GNUPG:] FAILURE sign $code"
    if [ -e "$root/non-english" ]; then
      echo 'gpg: signature echouee: mot de passe errone' >&2
    else
      echo 'gpg: signing failed: Bad passphrase' >&2
    fi
    exit 2
  fi
  if [ -e "$root/daemon-tools" ]; then
    rm -f "$root/locked"
  fi
fi

if [ "$background" = 1 ] && [ -e "$root/cancel-no-failure" ]; then
  echo '[GNUPG:] KEY_CONSIDERED C1D6F8E1B1E8D5FBFF34ACE08FACE96FA6D9DB48 0'
  echo 'gpg: signing failed: Operation cancelled' >&2
  exit 2
fi

if [ -e "$root/status-on-rich" ] && [ ! -e "$root/rich" ]; then
  exit 0
fi

echo '[GNUPG:] KEY_CONSIDERED C1D6F8E1B1E8D5FBFF34ACE08FACE96FA6D9DB48 0'
if [ "$background" != 1 ] && [ "$loopback" != 1 ] && [ ! -e "$root/cached" ]; then
  if [ -e "$root/status-on-rich" ]; then
    echo '[GNUPG:] PINENTRY_LAUNCHED 2718 gnome3 1.3.2 not a tty dumb :0 ? 1000/1000 -'
  else
    echo '[GNUPG:] PINENTRY_LAUNCHED 2718 gnome3 1.3.2 x'
  fi
  if [ -e "$root/daemon-tools" ]; then
    rm -f "$root/locked"
  fi
fi
echo '[GNUPG:] SIG_CREATED D 22 10 00 1789136997 97CF31DBA5F6012341995ED8F3C83A12ADCE45A1'
exit 0
